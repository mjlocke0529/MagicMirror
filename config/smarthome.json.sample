  "modules": [
    {
      "id": "apps",
      "name": "Apps",
      "module": "MMM-SmartHomeApps",
      "position": "middle_center",
      "enabled": true
    },
    {
      "id": "clock",
      "name": "Clock",
      "module": "clock",
      "position": "bottom_left",
      "enabled": true
    },
    {
      "id": "calendar",
      "name": "Calendar",
      "module": "calendar",
      "position": "top_left",
      "enabled": false,
      "header": "US Holidays",
      "config": {
        "calendars": [
          {
            "fetchInterval": 604800000,
            "symbol": "calendar-check",
            "url": "https://ics.calendarlabs.com/76/mm3137/US_Holidays.ics"
          }
        ]
      }
    },
    {
      "id": "weather-current",
      "name": "Weather (current)",
      "module": "weather",
      "position": "top_right",
      "enabled": true,
      "config": {
        "weatherProvider": "openmeteo",
        "type": "current"
      }
    },
    {
      "id": "weather-forecast",
      "name": "Weather (forecast)",
      "module": "weather",
      "position": "top_right",
      "enabled": false,
      "header": "Weather Forecast",
      "config": {
        "weatherProvider": "openmeteo",
        "type": "forecast"
      }
    },
    {
      "id": "news",
      "name": "News",
      "module": "newsfeed",
      "position": "bottom_bar",
      "enabled": false,
      "config": {
        "feeds": [
          {
            "title": "New York Times",
            "url": "https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml"
          }
        ],
        "showSourceTitle": true,
        "showPublishDate": true,
        "broadcastNewsFeeds": true,
        "broadcastNewsUpdates": true
      }
    },
    {
      "id": "compliments",
      "name": "Compliments",
      "module": "compliments",
      "position": "lower_third",
      "enabled": false
    },
    {
      "id": "hero",
      "name": "Trending (hero)",
      "module": "MMM-SmartHomeHero",
      "position": "upper_third",
      "enabled": true
    }
  ]
