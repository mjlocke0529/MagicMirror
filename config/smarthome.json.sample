    "lon": -122.44429
  },
  "hero": {
    "tmdbApiKey": "",
    "types": [
      "movie",
      "tv"
    ],
    "interval": 10000,
    "region": "US"
  },
  "appearance": {
    "theme": "fullwidth",
    "accent": "#cf2626"
  },
  "topbar": {
    "greeting": true,
    "name": "",
    "search": true,
    "showWeather": true,
    "showTime": true,
    "links": [
      {
        "name": "YouTube",
        "url": "https://www.youtube.com/"
      },
      {
        "name": "Traffic",
        "url": "https://www.google.com/maps/@47.2529,-122.4443,11z/data=!5m1!1e1"
      },
      {
        "name": "News",
        "url": "https://news.google.com/"
      }
    ]
  },
  "apps": [
    {
      "name": "Netflix",
      "url": "https://www.netflix.com/browse",
      "color": "#e50914",
      "hidden": false,
      "locked": false
    },
    {
      "name": "Disney+",
      "url": "https://www.disneyplus.com/home",
      "color": "#0f3fa3",
      "hidden": false,
      "locked": false
    }
  ],
  "modules": [
    {
      "id": "topbar",
      "name": "Top bar",
      "module": "MMM-SmartHomeTopBar"
    },
    {
      "id": "hero",
      "name": "Trending hero",
      "module": "MMM-SmartHomeHero"
    },
    {
      "id": "apps",
      "name": "App rail",
      "module": "MMM-SmartHomeApps"
    },
    {
      "id": "clock",
      "name": "Clock",
      "module": "clock"
    },
    {
      "id": "calendar",
      "name": "Calendar",
      "module": "calendar",
      "header": "US Holidays",
      "config": {
        "calendars": [
          {
            "fetchInterval": 604800000,
            "symbol": "calendar-check",
            "url": "https://ics.calendarlabs.com/76/mm3137/US_Holidays.ics"
          }
        ]
      }
    },
    {
      "id": "weather",
      "name": "Weather now",
      "module": "weather",
      "config": {
        "weatherProvider": "openmeteo",
        "type": "current"
      }
    },
    {
      "id": "forecast",
      "name": "Forecast",
      "module": "weather",
      "header": "Weather Forecast",
      "config": {
        "weatherProvider": "openmeteo",
        "type": "forecast"
      }
    },
    {
      "id": "news",
      "name": "News",
      "module": "newsfeed",
      "config": {
        "feeds": [
          {
            "title": "New York Times",
            "url": "https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml"
          }
        ],
        "showSourceTitle": true,
        "showPublishDate": true,
        "broadcastNewsFeeds": true,
        "broadcastNewsUpdates": true
      }
    },
    {
      "id": "compliments",
      "name": "Compliments",
      "module": "compliments"
    }
  ],
  "layout": {
    "topbar": true,
    "sections": [
      {
        "id": "upper",
        "enabled": true,
        "size": 2,
        "split": "1",
        "slots": [
          "hero"
        ]
      },
      {
        "id": "middle",
        "enabled": true,
        "size": 1,
        "split": "1",
        "slots": [
          "apps"
        ]
      },
      {
        "id": "lower",
        "enabled": true,
        "size": 1,
        "split": "2",
        "slots": [
          "clock",
          "weather"
        ]
      }
    ],
    "bottombar": {
      "enabled": false,
      "slots": [
        "news"
      ]
    }
  }
}